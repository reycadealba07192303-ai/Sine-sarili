MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=4000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SineSarili <no-reply@example.com>

# Receipt AI: OpenRouter takes priority when its key is set. Choose a model
# supporting image input and JSON Schema structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional legacy provider, used only when OPENROUTER_API_KEY is absent.
ANTHROPIC_API_KEY=

# Multi-DRM integration: keep disabled until a DRM gateway and encrypted assets are ready.
DRM_ENABLED=false
# HTTPS gateway templates; {assetId} is replaced server-side. Gateway must bind
# challenge KIDs to that asset and return raw binary licenses (SPC -> CKC for FairPlay).
DRM_WIDEVINE_LICENSE_URL=
DRM_PLAYREADY_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_FAIRPLAY_CERTIFICATE_URL=
# Full Authorization header value, e.g. Bearer <gateway-secret>. Server-only.
DRM_LICENSE_AUTHORIZATION=
DRM_PROVIDER=gateway
AXINOM_COMMUNICATION_KEY_ID=
AXINOM_COMMUNICATION_KEY=
AXINOM_WIDEVINE_LICENSE_URL=
AXINOM_PLAYREADY_LICENSE_URL=
AXINOM_FAIRPLAY_LICENSE_URL=

# --- Hosting on Vercel ---
# Two Vercel Blob stores. Public: artwork, teasers, encrypted streams. Private: film masters, receipts.
# Leave both empty for local development (files are saved to apps/api/uploads).
PUBLIC_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
# Shared secret for the GitHub Actions encryption worker (at least 32 random characters).
DRM_WORKER_SECRET=
# Optional: start encryption right after a save instead of waiting up to 15 minutes.
# A GitHub token that can trigger workflows on the repo, and the repo as "owner/name".
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=
